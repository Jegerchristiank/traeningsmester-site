{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/afmeld",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/slet-konto",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/ai/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "xn--trningsmester-4fb.dk"
        }
      ],
      "destination": "https://www.traeningsmester.dk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.xn--trningsmester-4fb.dk"
        }
      ],
      "destination": "https://www.traeningsmester.dk/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/shell.html"
    },
    {
      "source": "/app/",
      "destination": "/shell.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/shell.html"
    },
    {
      "source": "/privatliv",
      "destination": "/privatliv.html"
    },
    {
      "source": "/vilkaar",
      "destination": "/vilkaar.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/tilgaengelighed",
      "destination": "/tilgaengelighed.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/slet-konto",
      "destination": "/slet-konto.html"
    },
    {
      "source": "/afmeld",
      "destination": "/shell.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/mcp-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/oauth",
      "destination": "/api/mcp-metadata?kind=authorization"
    },
    {
      "source": "/oauth/.well-known/oauth-authorization-server",
      "destination": "/api/mcp-metadata?kind=authorization"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/oauth?route=:path*"
    },
    {
      "source": "/ai/:path*",
      "destination": "/shell.html"
    }
  ]
}
